# Copy to .env and fill in values. Never commit .env

# MongoDB Atlas free cluster
# Replace USER, PASSWORD (URL-encode if it has @ # etc.), and cluster host
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/job_aggregator?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=job_aggregator

PORT=8787
CORS_ORIGIN=http://localhost:5173

# Delete jobs older than N days (postedAt / lastSeenAt / scrapedAt)
JOB_RETENTION_DAYS=15
